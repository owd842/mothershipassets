    "version": "0.2.0",
    "configurations": [
        {
            "name": "Attach to Command Line",
            "type": "node",
            "request": "attach",
            "port": 9229,
            "skipFiles": ["<node_internals>/**"],
            "restart": true,
            "preLaunchTask": "Run My Script",
            "postDebugTask": "stop-my-task",
            "env": {
                "NODE_PATH": "${workspaceFolder}/node_modules"
            }
        },
        {
            "name": "Python: Attach using Process ID",
            "type": "python",
            "request": "attach",
            "processId": "${command:pickProcess}"
        },
        {
            "name": "Python Debugger: Current File",
            "type": "python",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "python": "Z:\\ProgramData\\owd\\python\\work\\Portable Python-3.10.5 x64\\App\\Python\\python.exe"
        },
        {
            "type": "node",
            "request": "launch",
            "name": "Launch NodeJS Script",
            "skipFiles": ["<node_internals>/**"],
            "runtimeExecutable": "C:\\Program Files\\Adobe\\Adobe Creative Cloud Experience\\libs\\node.exe",
            // "C:\\Users\\KIDS2022\\AppData\\Local\\node.exe",
            // "C:\\Program Files\\Adobe\\Adobe Creative Cloud Experience\\libs\\node.exe",
            // "C:\\Program Files\\nodejs\\node.exe",
            // "C:\\ProgramData\\owd\\node-v26.4.0-win-x64\\node.exe",
            // "C:\\Users\\${env:USERNAME}\\AppData\\Local\\node-v26.4.0-win-x64\\node.exe",
            // "runtimeExecutable": "C:\\Program Files\\nodejs\\node.exe",
            // C:\Program Files\Adobe\Adobe Creative Cloud Experience\libs
            // "C:\\Users\\LC2022\\AppData\\Local\\node-v26.4.0-win-x64\\node.exe"
            // C:\Users\General\AppData\Local\node-v26.4.0-win-x64
            "program": "${file}",
            // "preLaunchTask": "Init adobeupdate",
            "cwd": "${workspaceFolder}",
            "args": ["--inspect-brk=9229"],
            // runtimeArgs
            "autoAttachChildProcesses": true,
            "env": {
                "NODE_PATH": "${workspaceFolder}/node/node_modules"
            },
            "console": "integratedTerminal"
        }
    ]
}
