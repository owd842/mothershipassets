function writeToChildProcess(child, msg) {
    if (!child) {
        throw new Error("child process is null");
    }

    if (child.stdin.writable) {
        logmsg(`writing msg to child process: ${child.pid} -- ` + msg);
        child.stdin.write(msg);
        // child.stdin.end();
    }
}

